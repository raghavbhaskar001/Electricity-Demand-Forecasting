# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to `.env` for local overrides. Never commit `.env` to Git.
# No proprietary API keys are required by the core pipeline or simulator.
# ==============================================================================

# Local HTTP dashboard & PyTorch simulator server binding
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8505

# Reproducible random seed for training and scenario generation
PROJECT_RANDOM_SEED=42

# Public open-data endpoints (no authentication token required for CC0/CC-BY datasets)
DATAVERSE_BASE_URL=https://dataverse.harvard.edu
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Optional Harvard Dataverse API token (only if rate-limited during bulk raw downloads)
DATAVERSE_API_TOKEN=your_optional_dataverse_token_here
